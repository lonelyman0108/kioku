{
  "description": "会话开始时注入 Kioku 启动加载的内容，每轮输入时注入召回候选，每轮回复后把这一轮交给 Kioku 写会话摘要",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/forward.mjs\" session.start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/forward.mjs\" prompt.submit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/forward.mjs\" turn.end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
