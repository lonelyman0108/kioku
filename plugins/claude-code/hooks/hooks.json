{
  "description": "会话开始时注入 Kioku 的启动上下文，每轮输入时注入召回候选",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/forward.mjs\" session.start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/forward.mjs\" prompt.submit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
