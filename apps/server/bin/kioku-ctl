#!/usr/bin/env node
for (const stream of [process.stdout, process.stderr]) {
  stream.on('error', (err) => {
    if (!err || err.code !== 'EPIPE') throw err
  })
}

Promise.all([import('node:fs'), import('node:path'), import('node:url')])
  .then(([fs, path, url]) => {
    const root = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..')
    return import(url.pathToFileURL(path.join(root, 'dist', 'ctl.mjs')).href)
  })
  .then((ctl) => ctl.runCtl(process.argv.slice(2)))
  .then((code) => {
    process.exitCode = code
  })
  .catch((err) => {
    console.error(err instanceof Error ? err.message : err)
    process.exitCode = 1
  })
