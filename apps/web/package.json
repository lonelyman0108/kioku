{
  "name": "@kioku/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.app.json",
    "typecheck": "vite build --mode typecheck --logLevel warn && vue-tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kioku/contracts": "workspace:*",
    "@nuxt/ui": "4.12.0",
    "@tanstack/vue-query": "5.104.5",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
