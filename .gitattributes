# 行尾统一为 LF，二进制文件不做换行转换也不做文本 diff。
* text=auto eol=lf

# 脚本必须是 LF，否则在 Linux runner 上 shebang 失效
*.sh text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pen binary

# 锁文件：diff 里折叠，合并冲突时整份重新生成
pnpm-lock.yaml -diff linguist-generated
package-lock.json -diff linguist-generated
go.sum -diff linguist-generated
