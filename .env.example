# docker-compose.example.yml 用的配置。复制为 .env 后填写，.env 不要提交。

# 数据库超级用户与应用角色的密码，生成：openssl rand -hex 24
# 应用角色的密码会拼进连接串，只用十六进制字符，避免 @ : / 之类的字符破坏连接串
POSTGRES_PASSWORD=
KIOKU_DB_PASSWORD=

# secret 级记忆与嵌入接口 Key 的加密主密钥，生成：openssl rand -base64 32
# 丢失后已加密的内容无法解密，和数据库备份分开保存
KIOKU_MASTER_KEY=

# 只用局域网 http:// 地址访问管理界面时设为 false，否则浏览器不保存登录 Cookie；经 HTTPS 访问时保持 true
KIOKU_COOKIE_SECURE=true

# 前面有几层受信任的反向代理；直接暴露端口时保持 0，否则 X-Forwarded-For 可以伪造
KIOKU_TRUSTED_PROXIES=0

# 端口发布到哪个地址。放在反向代理后面时设为 127.0.0.1，免得别人绕过代理直连
KIOKU_BIND=0.0.0.0
